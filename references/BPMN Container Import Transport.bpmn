<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="container-import" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:collaboration id="Collaboration_1">
    <bpmn2:documentation>Hinterland transport of an import container, as one bilateral process between the forwarder and the transport service provider. The transport service provider owns the Container import state, so every state box sits in its lane, including the states the other party causes. A step belongs to the party that takes the action; the owner recording the result is a side effect, not a step. The black-box pools are the processes it hooks into; the message flows mirror the ones drawn in those processes' own BPMNs.</bpmn2:documentation>
    <bpmn2:participant id="Participant_1" name="Container import" processRef="Process_ContainerImport" />
    <bpmn2:participant id="Participant_Agency" name="Import agency at destination" />
    <bpmn2:participant id="Participant_SCR" name="Secure container release" />
    <bpmn2:participant id="Participant_TerminalVisit" name="Terminal visit" />
    <bpmn2:participant id="Participant_ECMR" name="eCMR consignment note" />
    <bpmn2:messageFlow id="Obs_OncarriageBooked" name="Import order [oncarriage booked]" sourceRef="Participant_Agency" targetRef="StartEvent_1" />
    <bpmn2:messageFlow id="Obs_RightsAssigned" name="Container release right [pickup rights assigned]" sourceRef="Participant_SCR" targetRef="Task_ReceivePickupRight" />
    <bpmn2:messageFlow id="Obs_TransferToSCR" name="Container import [pickup assigned]" sourceRef="Task_TransferPin" targetRef="Participant_SCR" />
    <bpmn2:messageFlow id="Obs_DeliveryPlannedToVisit" name="Container import [delivery planned]" sourceRef="Task_PlanDelivery" targetRef="Participant_TerminalVisit" />
    <bpmn2:messageFlow id="Obs_VisitCompleted" name="Terminal visit [completed]" sourceRef="Participant_TerminalVisit" targetRef="Task_ConfirmPickup" />
    <bpmn2:messageFlow id="Obs_PickedUpToAgency" name="Container import [picked up]" sourceRef="Task_ConfirmPickup" targetRef="Participant_Agency" />
    <bpmn2:messageFlow id="Obs_DeliveredToAgency" name="Container import [delivered]" sourceRef="Task_ConfirmDelivery" targetRef="Participant_Agency" />
    <bpmn2:messageFlow id="Obs_TransportPlanned" name="Container import [transport planned]" sourceRef="Task_PlanTransport" targetRef="Participant_ECMR" />
    <bpmn2:messageFlow id="Obs_DeliveredToECMR" name="Container import [delivered]" sourceRef="Task_ConfirmDelivery" targetRef="Participant_ECMR" />
  </bpmn2:collaboration>
  <bpmn2:process id="Process_ContainerImport" isExecutable="false">
    <bpmn2:laneSet id="LaneSet_1">
      <bpmn2:lane id="Lane_Forwarder" name="Forwarder">
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_SendRequest</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_Update</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_SendUpdate</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_UpdateJoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_CommercialRelease</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ReceivePickupRight</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_TransferPin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Complete</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_1</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Transporter" name="Transport service provider">
        <bpmn2:flowNodeRef>Task_PlanDelivery</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_PlanTransport</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ConfirmPickup</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ConfirmDelivery</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>
    <bpmn2:startEvent id="StartEvent_1" name="Container import booking" />
    <bpmn2:task id="Task_SendRequest" name="Send transport request&#10;(B/L details + ETA)">
      <bpmn2:documentation>Booking sent to the transporter. Carries the full B/L details and the vessel ETA. The transport service provider records the request as a side effect; receiving it is not a step.</bpmn2:documentation>
      <bpmn2:dataOutputAssociation id="DataOut_Requested">
        <bpmn2:targetRef>DataRef_Requested</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Gateway_Update" name="Booking update?" default="Flow_NoUpdate" />
    <bpmn2:task id="Task_SendUpdate" name="Send booking update">
      <bpmn2:dataOutputAssociation id="DataOut_RequestUpdated">
        <bpmn2:targetRef>DataRef_RequestUpdated</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Gateway_UpdateJoin" />
    <bpmn2:task id="Task_PlanDelivery" name="Plan / book delivery">
      <bpmn2:dataOutputAssociation id="DataOut_DeliveryPlanned">
        <bpmn2:targetRef>DataRef_DeliveryPlanned</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_PlanTransport" name="Plan hinterland transport">
      <bpmn2:documentation>Repeated per leg: a hinterland move can be multi-leg, e.g. barge or rail plus a final road leg.</bpmn2:documentation>
      <bpmn2:dataOutputAssociation id="DataOut_TransportPlanned">
        <bpmn2:targetRef>DataRef_TransportPlanned</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn2:task>
    <bpmn2:task id="Task_CommercialRelease" name="Commercial release">
      <bpmn2:dataOutputAssociation id="DataOut_Released">
        <bpmn2:targetRef>DataRef_Released</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_ReceivePickupRight" name="Receive pickup rights">
      <bpmn2:documentation>Attachment point to the secure container release chain: the secure release provider notifies the forwarder as first rights holder. Until the pickup rights are actually held, the forwarder has nothing to pass on to the transporter.</bpmn2:documentation>
      <bpmn2:dataOutputAssociation id="DataOut_PickupRightReceived">
        <bpmn2:targetRef>DataRef_PickupRightReceived</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_TransferPin" name="Transfer pickup right / PIN">
      <bpmn2:dataOutputAssociation id="DataOut_PickupAssigned">
        <bpmn2:targetRef>DataRef_PickupAssigned</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_ConfirmPickup" name="Pickup confirmation">
      <bpmn2:dataOutputAssociation id="DataOut_PickedUp">
        <bpmn2:targetRef>DataRef_PickedUp</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_ConfirmDelivery" name="Delivery confirmation">
      <bpmn2:dataOutputAssociation id="DataOut_Delivered">
        <bpmn2:targetRef>DataRef_Delivered</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Task_Complete" name="Complete">
      <bpmn2:dataOutputAssociation id="DataOut_Completed">
        <bpmn2:targetRef>DataRef_Completed</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:endEvent id="EndEvent_1" name="Container import completed" />
    <bpmn2:dataObjectReference id="DataRef_Requested" name="Container import&#10;[requested]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_Requested" name="requested" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_RequestUpdated" name="Container import&#10;[request-updated]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_RequestUpdated" name="request-updated" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_DeliveryPlanned" name="Container import&#10;[delivery planned]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_DeliveryPlanned" name="delivery planned" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_TransportPlanned" name="Container import&#10;[transport planned]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_TransportPlanned" name="transport planned" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_Released" name="Container import&#10;[released]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_Released" name="released" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_PickupRightReceived" name="Container import&#10;[pickup rights received]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_PickupRightReceived" name="pickup rights received" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_PickupAssigned" name="Container import&#10;[pickup assigned]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_PickupAssigned" name="pickup assigned" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_PickedUp" name="Container import&#10;[picked up]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_PickedUp" name="picked up" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_Delivered" name="Container import&#10;[delivered]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_Delivered" name="delivered" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObjectReference id="DataRef_Completed" name="Container import&#10;[completed]" dataObjectRef="DataObject_Import">
      <bpmn2:dataState id="State_Completed" name="completed" />
    </bpmn2:dataObjectReference>
    <bpmn2:dataObject id="DataObject_Import" name="Container import" />
    <bpmn2:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_SendRequest" />
    <bpmn2:sequenceFlow id="Flow_02" sourceRef="Task_SendRequest" targetRef="Gateway_Update" />
    <bpmn2:sequenceFlow id="Flow_Update" name="Yes" sourceRef="Gateway_Update" targetRef="Task_SendUpdate" />
    <bpmn2:sequenceFlow id="Flow_05" sourceRef="Task_SendUpdate" targetRef="Gateway_UpdateJoin" />
    <bpmn2:sequenceFlow id="Flow_NoUpdate" name="No" sourceRef="Gateway_Update" targetRef="Gateway_UpdateJoin" />
    <bpmn2:sequenceFlow id="Flow_08" sourceRef="Gateway_UpdateJoin" targetRef="Task_PlanDelivery" />
    <bpmn2:sequenceFlow id="Flow_09" sourceRef="Task_PlanDelivery" targetRef="Task_PlanTransport" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Task_PlanTransport" targetRef="Task_CommercialRelease" />
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Task_CommercialRelease" targetRef="Task_ReceivePickupRight" />
    <bpmn2:sequenceFlow id="Flow_11b" sourceRef="Task_ReceivePickupRight" targetRef="Task_TransferPin" />
    <bpmn2:sequenceFlow id="Flow_12" sourceRef="Task_TransferPin" targetRef="Task_ConfirmPickup" />
    <bpmn2:sequenceFlow id="Flow_13" sourceRef="Task_ConfirmPickup" targetRef="Task_ConfirmDelivery" />
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="Task_ConfirmDelivery" targetRef="Task_Complete" />
    <bpmn2:sequenceFlow id="Flow_15" sourceRef="Task_Complete" targetRef="EndEvent_1" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
