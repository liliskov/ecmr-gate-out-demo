          <dc:Bounds x="828" y="713" width="70" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataRef_Task_Publish" bpmnElement="DataRef_Task_Publish">
        <dc:Bounds x="1148" y="705" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1188" y="713" width="70" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataRef_Task_Takeover" bpmnElement="DataRef_Task_Takeover">
        <dc:Bounds x="1508" y="705" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1548" y="713" width="70" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataRef_Task_Delivery" bpmnElement="DataRef_Task_Delivery">
