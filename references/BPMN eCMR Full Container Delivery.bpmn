          <dc:Bounds x="2088" y="713" width="70" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Anno_Preparation" bpmnElement="Anno_Preparation">
        <dc:Bounds x="400" y="294" width="330" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Anno_Subcontract" bpmnElement="Anno_Subcontract">
        <dc:Bounds x="760" y="294" width="240" height="70" />
      </bpmndi:BPMNShape>
