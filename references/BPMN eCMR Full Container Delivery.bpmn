        <dc:Bounds x="1680" y="388" width="390" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="318" y="440" />
        <di:waypoint x="420" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="540" y="440" />
        <di:waypoint x="600" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="720" y="440" />
        <di:waypoint x="780" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="900" y="440" />
        <di:waypoint x="995" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1045" y="440" />
        <di:waypoint x="1140" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1059" y="420" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1260" y="440" />
        <di:waypoint x="1355" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_NoEfti" bpmnElement="Flow_NoEfti">
        <di:waypoint x="1020" y="415" />
