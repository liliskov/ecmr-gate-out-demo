        <di:waypoint x="1380" y="350" />
        <di:waypoint x="1380" y="415" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1026" y="352" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1405" y="440" />
        <di:waypoint x="1452.5" y="440" />
        <di:waypoint x="1452.5" y="620" />
        <di:waypoint x="1500" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1620" y="620" />
        <di:waypoint x="1680" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="1800" y="620" />
        <di:waypoint x="1860" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15">
        <di:waypoint x="1980" y="620" />
        <di:waypoint x="2040" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_16" bpmnElement="Flow_16">
        <di:waypoint x="2160" y="620" />
        <di:waypoint x="2262" y="620" />
